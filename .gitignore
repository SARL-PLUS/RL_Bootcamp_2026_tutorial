# MkDocs build output (generated by `mkdocs build`)
/site/

# Training artifacts
runs/
**/runs/
*.mp4

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# IDE / OS
.idea/
.vscode/
.DS_Store

# transfer_benchmark.py output
benchmark/

# Instructor solutions — the CODE is tracked so it is recoverable; the
# artefacts are not. Participants receive a filtered export, not this repo,
# so keeping the reference solution in history here is safe.
# `runs/`, `**/runs/` and `*.mp4` above already cover most of it.
/solutions/**/checkpoints/
/solutions/**/renders/
*.zip

# The injection-probe raw data: 276k rows / 23 MB, and fully regenerable with
# `python solutions/advanced/reference_solution/reward_probe.py` (~2 min).
# The FIGURE it feeds is committed, so the deck builds from a fresh clone;
# only `--plot-only` needs this file back.
slides/data/air_probe.csv

# Stray LaTeX droppings at the repo root (slides/*.log are deliberately tracked)
/texput.log

# Competition private seed list — regenerable from the salt, never committed.
# The salt is the secret; this file is just its expansion.
sessions/03-advanced/competition/seeds_private.txt
# Competition artefacts: action traces and exported solutions. Regenerable from
# a checkpoint and a seed list, large, and one of them carries the secret seeds.
submission.csv
submission_*.csv
sample_submission.csv
solution.csv
solution*.csv
# Submitted zips and whatever they unpack into.
sessions/03-advanced/submissions/

# Published checkpoints. `*.zip` and `runs/` above keep training artefacts out;
# these three are the exception, because participant-facing material promises
# them: Session #2's exercises offer a pre-trained walker instead of an hour of
# compute, and Session #3's deck quotes an agent nobody can otherwise load.
# Copies, not run directories — the runs stay untracked.
#
# NOTE the `**`: the Crippled Ant checkpoints are one directory deeper
# (`checkpoints/<run>/final_model.zip`), so a single-level `*.zip` exception
# silently missed two of the three published policies while still committing
# their config and VecNormalize stats — a fresh clone got populated-looking
# directories with no policy in them.
!sessions/02-intermediate/crippled-ant/checkpoints/
!sessions/02-intermediate/crippled-ant/checkpoints/**/
!sessions/02-intermediate/crippled-ant/checkpoints/**/*.zip
!sessions/02-intermediate/crippled-ant/checkpoints/**/*.pkl
!sessions/03-advanced/airtraffic/checkpoints/
!sessions/03-advanced/airtraffic/checkpoints/**/*.zip
!sessions/03-advanced/airtraffic/checkpoints/*.zip
